# StaySync Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=staysync_super_secret_jwt_key_2026_evaluation_1
JWT_EXPIRES_IN=7d

# Database Configuration
# Supported drivers: 'sqlite' (zero-config default for quick local evaluation) or 'postgres'
DB_DRIVER=sqlite
DATABASE_URL=postgres://staysync:staysync_pass@localhost:5432/staysync_db
SQLITE_DB_PATH=./staysync_dev.db

# Redis Configuration (Evaluation 2 readiness)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka / Message Broker (Evaluation 2 readiness)
KAFKA_BROKERS=localhost:9092
